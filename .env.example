# The default agent provider is Ollama (local, free, no keys).
# Install Ollama (https://ollama.com), then: `ollama pull qwen2.5:7b`
# and you're set.
#
# If you'd rather use a hosted model, uncomment one of the sections below.

# --- OpenAI ---
# FINCOPILOT_MODEL_PROVIDER=openai
# FINCOPILOT_MODEL_NAME=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Anthropic ---
# FINCOPILOT_MODEL_PROVIDER=anthropic
# FINCOPILOT_MODEL_NAME=claude-3-5-sonnet-latest
# ANTHROPIC_API_KEY=sk-ant-...

# --- Custom Ollama host (default is http://localhost:11434) ---
# OLLAMA_HOST=http://localhost:11434

# --- Data source ---
# Default is `synthetic`. Switch to `rossmann` (needs kaggle) or `online_retail`
# (downloads from UCI the first time).
# FINCOPILOT_DATA_SOURCE=synthetic
